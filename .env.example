# SPECTOR — environment placeholders
#
# The shipped product is a static PWA under public/ with no server-side
# runtime secrets. Paddle client tokens and Formspree form IDs used in
# public/ are publishable identifiers, not secret API keys.
#
# If you add a backend later, put REAL secrets only in untracked .env
# (see .gitignore). Never prefix secrets with NEXT_PUBLIC_, VITE_, or
# REACT_APP_.

# Optional local-only tooling (not used by the static site)
# PADDLE_API_KEY=pdl_sdbx_apikey_REPLACE_ME
# FORMSPREE_PRIVATE_KEY=REPLACE_ME
# WEBHOOK_SECRET=REPLACE_ME
